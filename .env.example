# ── Carrac — copy to .env, then `docker compose up -d` ────────────────────────
#
# Just want it running locally? `./scripts/quickstart.sh` does this copy, the
# four generated values below, and ADMIN_EMAIL for you — read on only if you
# want to set them yourself.
#
# Only the four values in this first block are required to boot. Everything
# below it is optional and the app degrades gracefully without it.
#
# `./scripts/configure.sh` asks for the optional keys below and writes them
# in for you, if you would rather not edit this file.
#
# Every optional key is COMMENTED OUT on purpose. Uncomment a key only when
# you give it a value: an uncommented `KEY=` with nothing after it is passed to
# the app as an empty string, which is not the same as unset (an empty
# numeric setting stops the app from starting).
#
# docker compose reads this file when it CREATES a container. After editing
# it, run `docker compose up -d --force-recreate`; `restart` does not pick up
# changes. Full reference: docs/configuration.md

# 1. Database + cache passwords. Any strong value; compose builds DATABASE_URL
#    and REDIS_URL from these, so they do not need to be set anywhere else.
#    Generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# 2. Session signing key. Rejected at startup if weak: needs >=16 characters
#    and >=8 distinct ones, and must not be this placeholder (the app refuses
#    to start in production if it is left as-is).
#    Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-me-with-the-command-above

# 3. Your account. Register at /register with THIS address and the account is
#    created as admin and can log in immediately without configuring outbound
#    email. Any other address registers fine but stays locked until it clicks
#    a verification link, which needs SMTP (below).
#    Replace this with your real address: production refuses to start while it
#    is still an @example.com/.org/.net value.
ADMIN_EMAIL=you@example.com

# ── Application ──────────────────────────────────────────────────────────────
DB_TYPE=postgresql
PORT=5000
DEBUG=False
LOG_LEVEL=INFO

# Running without Docker? Point this at your own PostgreSQL and Redis. (Under
# docker compose both are built from the passwords above and these lines are
# ignored.) With no DATABASE_URL at all the app falls back to SQLite files
# under DATA_DIR — fine for poking at the code, not for running it.
# DATABASE_URL=postgresql://carrac:password@localhost:5432/carrac
# REDIS_URL=redis://localhost:6379/0
# REDIS_SESSION_URL=redis://localhost:6379/1

# ── Session cookies ──────────────────────────────────────────────────────────
# Default true: the login cookie is marked Secure (HTTPS only) and HSTS is
# sent. Serving over plain HTTP — e.g. http://127.0.0.1:5002 with no TLS proxy
# in front — set this to false, or the cookie is not sent back and you are
# logged straight out again. quickstart.sh adds it to the .env it generates.
# SESSION_COOKIE_SECURE=false

# ── Public address ───────────────────────────────────────────────────────────
# The address people reach this instance at. Links in emails (verification,
# password reset, welcome) are built from it, and the iPhone widget script is
# served pointing at it. Unset, it defaults to http://localhost:5002, so set
# it before turning on email. Share and alert links use it too, falling back
# to the request's own address when it is unset.
# SITE_URL=https://carrac.example.com

# Hosts that serve only the public site; sign-in pages and signed-in visitors
# there are redirected to SITE_URL. Unset: no redirect.
# LANDING_HOSTS=example.com,www.example.com

# Your support address, shown on the legal and contact pages. Empty shows a
# placeholder there.
SUPPORT_EMAIL=

# Optional community invite link. Empty hides the Discord links in the app.
# DISCORD_INVITE_URL=https://discord.gg/your-invite
#
# Android widget: its server address is a BUILD setting, not an env var. Set
# carracBaseUrl in android-widget/local.properties (see
# docs/configuration.md, "Mobile widgets").

# ── Internal key + at-rest encryption (recommended) ─────────────────────────
# Shared key the app uses to call itself (server-side chart screenshots for
# journal entries, share images and the MCP chart tool; background chart
# refresh; the report engine). Without it those features fail or skip. It
# grants admin-level access on the X-Internal-Key header — keep it secret.
#    Generate with:  openssl rand -hex 32
# SCREENSHOT_API_KEY=

# Encrypts every secret stored in the database: users' Telegram bot tokens,
# exchange API secrets and webhook signing secrets. (The name is historical;
# it keys all of them.) Unset: Telegram tokens and webhook secrets are stored
# in plaintext and saving exchange API keys is refused.
#    Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TELEGRAM_TOKEN_ENCRYPTION_KEY=

# ── Market data ──────────────────────────────────────────────────────────────
# Crypto prices (Binance and friends) need no key. These add more.

# Macro data — free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Without it the macro panels are empty; nothing else is affected.
# FRED_API_KEY=

# Live US stock/ETF ticks over WebSocket (worker). Free key at finnhub.io.
# FINNHUB_API_KEY=

# Extra WebSocket streams in the worker, off by default.
# HYPERLIQUID_WS_ENABLED=true
# CCXT_WS_ENABLED=true

# Wallets the Hyperliquid smart-money collector falls back to when the public
# leaderboard is unavailable (comma-separated addresses). Empty: that run is
# skipped with a warning.
# HL_SMART_MONEY_WALLETS=

# ── AI (journal review, natural-language queries, in-app chat) ───────────────
# Off until a key is set. Every AI call is charged against the user's credit
# balance; an admin grants credits from the admin user page. In-app chat is
# shown to admins only unless a PostHog flag opens it to everyone.
#
# Anthropic:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
#
# Or any OpenAI-compatible chat-completions endpoint (set all three together;
# the built-in defaults pair an xAI URL with a Kimi model name):
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.x.ai/v1/chat/completions
# AI_MODEL=grok-4-1-fast-non-reasoning
#
# Ceiling on total AI spend per UTC day across all users, in USD. Enforced on
# in-app chat and the AI weekly review (see docs/configuration.md).
# AI_GLOBAL_DAILY_USD_CAP=30

# ── Email (any SMTP server with STARTTLS) ────────────────────────────────────
# Only needed so addresses OTHER than ADMIN_EMAIL can verify, and for password
# resets. The BREVO_ prefix is historical; any SMTP relay works. Set SITE_URL
# (above) first so the links in these emails point at your instance.
# BREVO_SMTP_HOST=smtp.example.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=
# BREVO_FROM_EMAIL=noreply@example.com
# BREVO_FROM_NAME=Carrac

# ── Notifications ────────────────────────────────────────────────────────────
# Web-push notifications — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Users can send their alerts to ntfy.sh topics out of the box. To also allow
# your own ntfy server, name its host here.
# NTFY_BASE_HOST=ntfy.example.com

# Operator alerts (the app telling YOU it is unhealthy) go to ntfy.
# Unset: they are dropped, with one error in the log per process.
# NTFY_BASE=https://ntfy.example.com
# NTFY_CARRAC_TOPIC=
# NTFY_MARKET_TOPIC=

# Optional Telegram mirror for urgent operator alerts and report delivery.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Error tracking ───────────────────────────────────────────────────────────
# Any Sentry-compatible endpoint (Sentry, Bugsink, GlitchTip). Unset = the SDK
# stays off entirely.
# SENTRY_DSN=https://your-key@sentry.example.com/1
# Browser-side reporting is a separate opt-in: the public DSN the page may
# use. Unset = the browser SDK is not loaded and /api/error-tunnel answers 404.
# The tunnel forwards to the host and project of SENTRY_DSN and only accepts
# envelopes naming this exact DSN. User id and tier are attached, never email.
# SENTRY_BROWSER_DSN=https://your-public-key@sentry.example.com/2

# ── Cloudflare Web Analytics ─────────────────────────────────────────────────
# Behind Cloudflare with Web Analytics switched on for the zone? Cloudflare
# injects its beacon at the edge, so the app cannot see it: set this to 1 to
# let the beacon through the Content-Security-Policy. Unset: it is blocked.
# CLOUDFLARE_WEB_ANALYTICS=1

# ── Sign-up ──────────────────────────────────────────────────────────────────
# Bot check on /register (Cloudflare Turnstile). Off unless BOTH are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Close public sign-up. Register your ADMIN_EMAIL account first: while this is
# false, /register only accepts invite codes.
# SIGNUPS_ENABLED=false

# Comma-separated X handles the report engine's macro research may search
# (needs XAI_API_KEY). Empty: that step runs without X search and logs a warning.
# X_SEARCH_HANDLES=

# ── Payments — never switched on; leave unset ────────────────────────────────
# Paddle billing code exists, but payments were never turned on in the
# original deployment. With PADDLE_API_KEY and PADDLE_CLIENT_TOKEN unset, all
# checkout UI stays hidden. The price ID settings default to empty.
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=sandbox

# Set by ./scripts/quickstart.sh — the login password it generated for
# ADMIN_EMAIL. Read back (never regenerated) on every re-run, so
# `./scripts/quickstart.sh --check` prints the same login. Irrelevant if
# you set ADMIN_EMAIL and your own password by hand.
# QUICKSTART_PASSWORD=
