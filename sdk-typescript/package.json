{
  "name": "@carrac_cc/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for Carrac — market data, plays, alerts, usage.",
  "license": "MIT",
  "author": "Gyula Pál",
  "keywords": ["carrac", "trading", "crypto", "market-data", "sdk"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.3"
  }
}
